# This service uses its own build context. Exclude local-only files, caches and
# secrets before Docker sends the context to the builder.
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.coverage
coverage.xml
dist/
build/
*.egg-info/
tests/
scripts/
artifacts/
!artifacts/
!artifacts/synthetic/
!artifacts/synthetic/ranking-lgbm-synthetic-v1-full.txt
!artifacts/synthetic/ranking-lgbm-synthetic-v1-full.txt.meta.json
!artifacts/synthetic/ranking-lgbm-synthetic-v1-full.txt.metrics.json
.git/
.gitignore
README.md
