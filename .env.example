APP_NAME=ai-service
PORT=3009
NODE_ENV=development
AI_RUNTIME_MODE=service

# Keep this value only in the service environment. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=20
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_QUALITY=medium
AI_IMAGE_PREVIEW_QUALITY=low
AI_IMAGE_PREVIEW_SIZE=1024x1024
AI_IMAGE_PREVIEW_FORMAT=jpeg
AI_IMAGE_PREVIEW_COMPRESSION=75
AI_IMAGE_PREVIEW_MAX_DIMENSION=1024
AI_IMAGE_PREVIEW_INPUT_FIDELITY=high
AI_IMAGE_PREVIEW_TIMEOUT_SECONDS=120
AI_IMAGE_FINAL_QUALITY=medium
AI_IMAGE_FINAL_SIZE=1024x1024
AI_IMAGE_FINAL_FORMAT=jpeg
AI_IMAGE_FINAL_COMPRESSION=85
AI_IMAGE_FINAL_MAX_DIMENSION=1024
AI_IMAGE_FINAL_INPUT_FIDELITY=high
AI_IMAGE_FINAL_TIMEOUT_SECONDS=120
LLM_PROVIDER=openai
PRODUCT_NAME_PROVIDER=openai
PRODUCT_DESCRIPTION_PROVIDER=openai
WHITE_BACKGROUND_PROVIDER=rembg
LIFESTYLE_BACKGROUND_PROVIDER=openai
OPENAI_IMAGE_OUTPUT_HOSTS=oaidalleapiprodscus.blob.core.windows.net,cdn.openai.com

AI_MAX_IMAGES=3
AI_MAX_TEXT_CHARS=6000
AI_CACHE_TTL_SECONDS=600
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=600

# Comma-separated CDN origins are supported, for example:
# https://cdn.example.com,https://media.example.com
MEDIA_PUBLIC_CDN_URL=

# Optional for the first local implementation. Redis support can be wired
# without changing the application or provider contracts.
REDIS_URL=
DATABASE_URL=
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_IMAGE_OPTIMIZATION_TOPIC=ai.image-optimization.requested.v1
KAFKA_IMAGE_OPTIMIZATION_DLQ_TOPIC=ai.image-optimization.dlq.v1
KAFKA_CONSUMER_GROUP=ai-service.image-optimization-worker.v1
MEDIA_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_URL=http://localhost:3008
INTERNAL_SERVICE_TOKEN=
AI_IMAGE_OPTIMIZATION_ENABLED=true
AI_IMAGE_MAX_PRODUCTS_PER_REQUEST=10
AI_IMAGE_RATE_LIMIT_REQUESTS=3
AI_IMAGE_RATE_LIMIT_WINDOW_SECONDS=3600
AI_IMAGE_MAX_RETRY_ATTEMPTS=3
AI_IMAGE_JOB_LEASE_SECONDS=300
AI_IMAGE_REVIEW_RETENTION_DAYS=30
AI_IMAGE_MAX_DIMENSION=2048
AI_IMAGE_WEBP_QUALITY=88
AI_IMAGE_WORKER_CONCURRENCY=2
AI_IMAGE_PROVIDER_MAX_CONCURRENCY=2
AI_IMAGE_OUTBOX_POLL_INTERVAL_MS=250
AI_IMAGE_KAFKA_POLL_TIMEOUT_MS=250
AI_IMAGE_LIFESTYLE_MAX_DIMENSION=1536
AI_IMAGE_LIFESTYLE_JPEG_QUALITY=88
AI_IMAGE_GENERATED_MAX_BYTES=20000000
AI_IMAGE_OUTBOX_MAX_ATTEMPTS=8
# Generate a Fernet key once and keep it only in the runtime secret store.
AI_IMAGE_BACKGROUND_ENCRYPTION_KEY=
