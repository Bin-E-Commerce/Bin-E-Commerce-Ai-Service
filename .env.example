# Copy file này thành `.env` khi chạy local.
# Không commit `.env`, API key, password database hoặc secret nội bộ lên Git.
#
# Quy tắc theo môi trường:
# - Local: có thể dùng localhost khi chạy trực tiếp trên máy.
# - Docker Compose/Kubernetes: dùng tên service/DNS nội bộ, không dùng localhost.
# - Production: secret phải được inject từ secret manager hoặc secret store,
#   không ghi cứng vào image và không truyền qua frontend.

# ============================================================================
# 01 · Runtime và HTTP API
# Ứng dụng đọc các biến này ngay khi khởi động để xác định chế độ chạy.
# ============================================================================

APP_NAME=ai-service                                      # Tên service dùng trong log/health response
PORT=3009                                                # Cổng HTTP mà Uvicorn lắng nghe
NODE_ENV=development                                     # development | test | production
AI_RUNTIME_MODE=service                                  # memory cho local nhẹ; service cho runtime tích hợp dependency thật

# ============================================================================
# 02 · Bảo mật và quyền gọi nội bộ
# API key chỉ nằm ở backend. Ranking endpoint và trusted internal call không phải
# API dành cho trình duyệt, nên phải có token do API Gateway/service truyền vào.
# ============================================================================

OPENAI_API_KEY=
INTERNAL_SERVICE_TOKEN=
REQUIRED_PERMISSION=seller.ai.product_content.generate  # Permission bắt buộc cho luồng AI của seller

# ============================================================================
# 03 · Kết nối dependency nền tảng
# AI Service dùng PostgreSQL để lưu job/outbox, Redis cho cache/rate limit và
# Kafka cho worker bất đồng bộ. Trong Docker, hostname phải là tên service.
# ============================================================================

DATABASE_URL=
REDIS_URL=
KAFKA_BOOTSTRAP_SERVERS=kafka:9092                       # Danh sách broker Kafka; không dùng localhost khi chạy trong Docker

# ============================================================================
# 04 · Kết nối service và media CDN
# Các URL này được AI Service dùng để đọc thông tin sản phẩm/media bằng request
# nội bộ. MEDIA_PUBLIC_CDN_URL là allowlist nguồn ảnh được phép gửi tới provider.
# ============================================================================

MEDIA_SERVICE_URL=http://media-service:3004               # Service quản lý asset/media nội bộ
PRODUCT_SERVICE_URL=http://product-service:3008           # Service sở hữu dữ liệu sản phẩm
RECOMMENDATION_SERVICE_URL=http://recommendation-service:3006 # Read model view/sales cho analytics impact
MEDIA_PUBLIC_CDN_URL=""                                 # Ví dụ: https://cdn.example.com,https://media.example.com

# ============================================================================
# 05 · Provider và giới hạn gọi AI có tính phí
# Provider được chọn ở backend; không cho frontend tự truyền provider/model tùy ý.
# Timeout và giới hạn request giúp kiểm soát latency, quota và chi phí OpenAI.
# ============================================================================

LLM_PROVIDER=openai                                      # Provider sinh nội dung văn bản
PRODUCT_NAME_PROVIDER=openai                             # Provider sinh tên sản phẩm
PRODUCT_DESCRIPTION_PROVIDER=openai                      # Provider sinh mô tả sản phẩm
WHITE_BACKGROUND_PROVIDER=rembg                          # Tách nền local bằng rembg/ONNX, không gọi API trả phí
LIFESTYLE_BACKGROUND_PROVIDER=openai                     # Sinh ảnh lifestyle qua provider đã cấu hình
OPENAI_MODEL=gpt-4.1-mini                                # Model sinh nội dung văn bản
OPENAI_IMAGE_MODEL=gpt-image-2                           # Model sinh/chỉnh ảnh
OPENAI_IMAGE_QUALITY=medium                              # Chất lượng mặc định cho output ảnh của provider
OPENAI_TIMEOUT_SECONDS=20                                # Timeout request văn bản
OPENAI_IMAGE_TIMEOUT_SECONDS=120                         # Timeout request ảnh, thường lâu hơn văn bản
OPENAI_IMAGE_OUTPUT_HOSTS=oaidalleapiprodscus.blob.core.windows.net,cdn.openai.com  # Host ảnh provider được phép tải

# ============================================================================
# 06 · Giới hạn request nội dung sản phẩm và cache
# Đây là lớp bảo vệ request đồng bộ: giới hạn số ảnh/ký tự, chống spam và giảm
# việc gọi lại provider khi cùng một input đã có kết quả trong cache.
# ============================================================================

AI_MAX_IMAGES=3                                          # Số ảnh tối đa trong một request sinh nội dung
AI_MAX_TEXT_CHARS=6000                                   # Tổng số ký tự context tối đa gửi vào pipeline
AI_CACHE_TTL_SECONDS=600                                 # Thời gian giữ kết quả cache nội dung
AI_RATE_LIMIT_REQUESTS=5                                 # Số request nội dung cho phép trong một cửa sổ
AI_RATE_LIMIT_WINDOW_SECONDS=600                         # Độ dài cửa sổ rate limit nội dung

# ============================================================================
# 07 · Chất lượng ảnh preview và final
# Preview ưu tiên tốc độ/chi phí để seller duyệt. Final ưu tiên chất lượng khi
# seller đã chấp nhận kết quả. Hai profile tách riêng để không cần sửa code.
# ============================================================================

AI_IMAGE_PREVIEW_QUALITY=low                             # low | medium | high
AI_IMAGE_PREVIEW_SIZE=1024x1024                          # Kích thước provider hỗ trợ; vẫn nén nhỏ sau khi nhận kết quả
AI_IMAGE_PREVIEW_FORMAT=jpeg                             # jpeg | png | webp
AI_IMAGE_PREVIEW_COMPRESSION=65                          # Mức nén preview
AI_IMAGE_PREVIEW_MAX_DIMENSION=768                       # Chặn ảnh preview quá lớn
AI_IMAGE_PREVIEW_INPUT_FIDELITY=high                     # low | high; mức giữ chi tiết ảnh đầu vào
AI_IMAGE_PREVIEW_TIMEOUT_SECONDS=120                     # Timeout pipeline preview

AI_IMAGE_FINAL_QUALITY=medium                            # low | medium | high
AI_IMAGE_FINAL_SIZE=1024x1024                            # Kích thước ảnh final
AI_IMAGE_FINAL_FORMAT=jpeg                               # jpeg | png | webp
AI_IMAGE_FINAL_COMPRESSION=85                            # Mức nén final cao hơn preview
AI_IMAGE_FINAL_MAX_DIMENSION=1024                        # Chặn ảnh final quá lớn
AI_IMAGE_FINAL_INPUT_FIDELITY=high                       # low | high
AI_IMAGE_FINAL_TIMEOUT_SECONDS=120                       # Timeout pipeline final

# ============================================================================
# 08 · Image optimization worker
# Worker xử lý job bất đồng bộ từ Kafka. Database là source of truth cho job;
# Kafka vận chuyển event; outbox/retry/DLQ giúp không mất job khi dependency lỗi.
# ============================================================================

AI_IMAGE_OPTIMIZATION_ENABLED=true                       # Bật/tắt feature image optimization ở AI Service
AI_IMAGE_MAX_PRODUCTS_PER_REQUEST=10                     # Số sản phẩm tối đa trong một batch
AI_IMAGE_RATE_LIMIT_REQUESTS=3                            # Fallback cho development/test; production cố định 2 lượt
AI_IMAGE_RATE_LIMIT_WINDOW_SECONDS=3600                  # Cửa sổ fallback; production cố định 24 giờ
AI_IMAGE_MAX_RETRY_ATTEMPTS=3                            # Số lần retry xử lý image job
AI_IMAGE_JOB_LEASE_SECONDS=300                           # Thời gian lease chống worker xử lý trùng job
AI_IMAGE_REVIEW_RETENTION_DAYS=30                        # Thời gian giữ kết quả chờ seller review
AI_IMAGE_MAX_DIMENSION=2048                              # Kích thước tối đa khi xử lý ảnh local
AI_IMAGE_WEBP_QUALITY=88                                 # Chất lượng WebP output local
AI_IMAGE_WORKER_CONCURRENCY=2                            # Số job image worker xử lý song song
AI_IMAGE_PROVIDER_MAX_CONCURRENCY=2                      # Giới hạn request đồng thời tới provider ảnh
AI_IMAGE_OUTBOX_POLL_INTERVAL_MS=250                     # Chu kỳ đọc outbox chưa publish
AI_IMAGE_KAFKA_POLL_TIMEOUT_MS=250                       # Timeout poll message Kafka
AI_IMAGE_LIFESTYLE_MAX_DIMENSION=1536                    # Kích thước tối đa ảnh lifestyle
AI_IMAGE_LIFESTYLE_JPEG_QUALITY=88                       # Chất lượng JPEG lifestyle
AI_IMAGE_GENERATED_MAX_BYTES=20000000                    # Chặn output provider vượt quá kích thước này
AI_IMAGE_OUTBOX_MAX_ATTEMPTS=8                           # Sau số lần này event được đưa vào DLQ
AI_IMAGE_BACKGROUND_ENCRYPTION_KEY=""                   # Fernet key; bắt buộc ở service mode khi feature image bật

KAFKA_IMAGE_OPTIMIZATION_TOPIC=ai.image-optimization.requested.v1  # Topic nhận job image
KAFKA_IMAGE_OPTIMIZATION_DLQ_TOPIC=ai.image-optimization.dlq.v1    # Topic chứa job lỗi không thể retry
KAFKA_CONSUMER_GROUP=ai-service.image-optimization-worker.v1        # Consumer group của image worker

# ============================================================================
# 09 · Embedding worker
# Embedding worker nhận yêu cầu từ Recommendation Service, gọi embedding provider
# rồi publish vector đã version hóa. Redis chỉ hỗ trợ cache/idempotency ngắn hạn;
# Qdrant mới là nơi Recommendation Service dùng để truy vấn vector.
# ============================================================================

EMBEDDING_PROVIDER=openai                               # Provider tạo embedding
EMBEDDING_MODEL=text-embedding-3-small                   # Model embedding
EMBEDDING_MODEL_VERSION=text-embedding-3-small           # Version logic dùng để kiểm tra tương thích vector
EMBEDDING_DIMENSIONS=1536                                # Số chiều phải khớp với collection Qdrant
EMBEDDING_TIMEOUT_SECONDS=30                             # Timeout mỗi lần gọi embedding provider
EMBEDDING_MAX_RETRY_ATTEMPTS=5                           # Số lần retry gọi provider
EMBEDDING_RESULT_CACHE_TTL_SECONDS=600                   # TTL cache kết quả embedding
EMBEDDING_REQUESTED_TOPIC=recommendation.product-embedding.requested.v1  # Topic yêu cầu tạo vector
EMBEDDING_GENERATED_TOPIC=recommendation.product-embedding.generated.v1  # Topic vector đã tạo
EMBEDDING_DLQ_TOPIC=recommendation.product-embedding.dlq.v1              # Topic vector lỗi
EMBEDDING_CONSUMER_GROUP=ai-service.embedding-worker.v1                  # Consumer group embedding worker

# ============================================================================
# 10 · LightGBM ranking model
# AI Service chỉ nhận tối đa một batch candidate đã được Recommendation Service
# chuẩn hóa. Không có artifact hoặc artifact lỗi thì model registry trả fallback,
# giúp Recommendation Service vẫn giữ đúng contract ranking.
# ============================================================================

RANKING_MODEL_PATH=""                                   # Ví dụ khi mount artifact: /app/artifacts/ranking.txt; để trống để dùng fallback
RANKING_MODEL_VERSION=ranking-fallback-v1                # Version ghi vào response/analytics
RANKING_EXPECTED_FEATURES=9                              # Số feature mỗi candidate phải có
RANKING_MAX_ITEMS=300                                    # Số candidate tối đa trong một request
RANKING_MAX_FEATURES=64                                  # Số feature tối đa được phép trong payload
